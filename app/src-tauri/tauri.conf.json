{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DIV Deck",
  "version": "0.2.1",
  "identifier": "com.divtecnologia.divdeck",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DIV Deck",
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        },
        "trafficLightPosition": {
          "x": 20,
          "y": 24
        }
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "copyright": "DIV Tecnologia",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "publisher": "DIV Tecnologia",
    "shortDescription": "App de controle do DIV Deck",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU2OTlDNzkxMEI5QTg3QUUKUldTdWg1b0xrY2VaVmhBQStiM0tJNDFHUlVERFdRTHZJNVlmRCtzY3ZCb1k2VW52ZlFCK25JVzkK",
      "endpoints": [
        "https://github.com/isaacviannadev/div-deck/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}